  "item": [
    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json;\r",
              "try {\r",
              "    json = pm.response.json();\r",
              "} catch (e) {\r",
              "    pm.test(\"Response is JSON\", function () {\r",
              "        pm.expect.fail(\"Response is not valid JSON\");\r",
              "    });\r",
              "    return;\r",
              "}\r",
              "\r",
              "/**\r",
              " * Adjust this section to match your actual response.\r",
              " * Try these in order, or set `token` directly from the real path.\r",
              " */\r",
              "let token =\r",
              "    json.access_token ||\r",
              "    json.token ||\r",
              "    (json.data && (json.data.access_token || json.data.token)) ||\r",
              "    (json.result && json.result.token);\r",
              "\r",
              "// Optional: if your token is at a custom path, set it explicitly, e.g.:\r",
              "// let token = json.data.jwt;\r",
              "\r",
              "pm.test(\"Token exists in response\", function () {\r",
              "    pm.expect(token, \"token must be present in response\").to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "// Save token as a collection variable so all requests in this collection can use it\r",
              "pm.collectionVariables.set(\"authToken\", token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"login\": \"admin\",\r\n  \"password\": \"password\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
